<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 is the LTS line (supported to Nov 2028); .NET 8 support ended on 10 Nov 2026. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DesktopBuddy</RootNamespace>
    <AssemblyName>DesktopBuddy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Lets the project build on non-Windows machines (CI, Linux dev boxes). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.53.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
